<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>WiGLE Recon — Mercado Livre</name>
    <description>APs and BLE devices mapped via WiGLE API. 200m geofence per point.</description>

    <!-- CORP Alphaville -->
    <Folder>
      <name>CORP Alphaville (Cisco enterprise)</name>
      <Style id="corp">
        <LineStyle><color>ff0000ff</color><width>2</width></LineStyle>
        <PolyStyle><color>40ff0000</color></PolyStyle>
      </Style>
      <Placemark><name>18:9C:5D:50:C7:43 — Al. Rio Negro 111</name>
        <description>MercadoLivre_CORP. Cisco AP. Obs: 26/fev/2020 (única). 6 anos sem sinal.</description>
        <Point><coordinates>-46.8476,-23.5039</coordinates></Point>
      </Placemark>
      <Placemark><name>200m geofence</name>
        <styleUrl>#corp</styleUrl>
        <Polygon><outerBoundaryIs><LinearRing><coordinates>
          -46.8494,-23.5021 -46.8494,-23.5057 -46.8458,-23.5057 -46.8458,-23.5021 -46.8494,-23.5021
        </coordinates></LinearRing></outerBoundaryIs></Polygon>
      </Placemark>
    </Folder>

